{
  "input": "input/raw.mp4",
  "output": "output/final.mp4",
  "cuts":    { "remove": [["3", "4.5"]] },
  "zooms": [
    { "at": "1-3",   "type": "punch", "amount": 1.3 },
    { "at": "6-9",   "type": "in",    "amount": 1.5 },
    { "at": "12-14", "type": "out",   "amount": 1.4 }
  ],
  "audio": {
    "bgm": "input/song.mp3", "bgm_volume": 0.2, "duck": true, "fade": 2,
    "sfx": [ { "file": "builtin:whoosh", "at": 1.0, "volume": 0.8 },
             { "file": "builtin:ding",   "at": 6.0 } ]
  },
  "graphics": [
    { "image": "input/logo.png", "at": "0-15", "position": "top-right", "scale": 0.2 },
    { "text": "JOIN OUR TEAM", "at": "1-3", "position": "middle", "box": "#E50914" }
  ],
  "captions": { "lang": "en", "max_words": 3, "upper": true, "highlight": "#FFD400", "position": "middle" }
}
